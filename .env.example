# ==============================================================================
# EMEK CONTA - ÇEVRE DEĞİŞKENLERİ (.env.example)
# Bu dosyayı .env.local olarak kopyalayıp gerçek değerlerinizi tanımlayabilirsiniz.
# ==============================================================================

# Resend API Anahtarı (https://resend.com üzerinden ücretsiz temin edilebilir)
# Tanımlanmadığında sistem geliştirme/simülasyon modunda çalışır ve konsola log yazar.
RESEND_API_KEY=re_your_api_key_here

# Yeni RFQ ve Numune Taleplerinin İletileceği Kurumsal E-posta(lar)
# Virgülle ayırarak birden fazla e-posta tanımlayabilirsiniz.
NOTIFICATION_EMAIL=info@emekconta.com,teklif@emekconta.com

# Gönderici E-posta Başlığı ve Adresi
# Resend'de emekconta.com domaini doğrulandıktan sonra 'Emek Conta <teklif@emekconta.com>' yapılabilir.
# Test aşamasında 'Emek Conta RFQ <onboarding@resend.dev>' kullanılabilir.
EMAIL_FROM=Emek Conta RFQ <onboarding@resend.dev>

# Site URL'si
NEXT_PUBLIC_SITE_URL=https://emekconta.com
